generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROPERTY_MANAGER
  MAINTENANCE_CONTRACTOR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum MaintenanceStatus {
  REPORTED
  TRIAGED
  SCHEDULED
  RESOLVED
}

enum EventType {
  CREATED
  STATUS_CHANGED
  CONTRACTOR_ASSIGNED
  CONTRACTOR_UNASSIGNED
  NOTE_ADDED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdRequests        MaintenanceRequest[]
  contractorAssignments  MaintenanceAssignment[]
  recordedPayments       RentPayment[]
  performedEvents        MaintenanceEvent[]
  dismissedAlerts        RentAlertDismissal[]
}

model Unit {
  id          String   @id @default(uuid())
  unitNumber  String
  address     String
  monthlyRent Decimal  @db.Decimal(10, 2)
  tenantName  String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  maintenanceRequests MaintenanceRequest[]
  rentPayments        RentPayment[]
  alertDismissals     RentAlertDismissal[]
}

model MaintenanceRequest {
  id          String            @id @default(uuid())
  unitId      String
  description String
  priority    Priority
  status      MaintenanceStatus @default(REPORTED)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  unit        Unit              @relation(fields: [unitId], references: [id])
  createdBy   User              @relation(fields: [createdById], references: [id])
  assignments MaintenanceAssignment[]
  events      MaintenanceEvent[]

  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([unitId])
}

model MaintenanceAssignment {
  id           String   @id @default(uuid())
  requestId    String
  contractorId String
  assignedAt   DateTime @default(now())

  request    MaintenanceRequest @relation(fields: [requestId], references: [id])
  contractor User               @relation(fields: [contractorId], references: [id])

  @@unique([requestId, contractorId])
  @@index([contractorId])
}

model RentPayment {
  id           String   @id @default(uuid())
  unitId       String
  amount       Decimal  @db.Decimal(10, 2)
  paymentMonth DateTime @db.Date
  recordedById String
  createdAt    DateTime @default(now())

  unit       Unit @relation(fields: [unitId], references: [id])
  recordedBy User @relation(fields: [recordedById], references: [id])

  @@unique([unitId, paymentMonth])
  @@index([paymentMonth])
  @@index([unitId])
}

model MaintenanceEvent {
  id        String    @id @default(uuid())
  requestId String
  actorId   String
  eventType EventType
  oldValue  String?
  newValue  String?
  note      String?
  createdAt DateTime  @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id])
  actor   User               @relation(fields: [actorId], references: [id])

  @@index([requestId])
  @@index([createdAt])
}

model RentAlertDismissal {
  id           String   @id @default(uuid())
  unitId       String
  paymentMonth DateTime @db.Date
  dismissedById String
  dismissedAt  DateTime @default(now())

  unit        Unit @relation(fields: [unitId], references: [id])
  dismissedBy User @relation(fields: [dismissedById], references: [id])

  @@unique([unitId, paymentMonth])
  @@index([unitId])
  @@index([paymentMonth])
}
